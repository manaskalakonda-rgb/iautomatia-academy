{
  // Browser code -> public/js (loaded by index.html as an ES module)
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "src",
    "outDir": "public/js"
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts"]
}
